#ifndef _CONFIG_H
#define _CONFIG_H

// clang-format off
#define FT_VERSION_MAJOR @version_major@
#define FT_VERSION_MINOR @version_minor@
#define FT_VERSION_PATCH @version_patch@

/* In LTTng mode, generate data according to this version */
#define LTTNG_VERSION_MAJOR 2
#define LTTNG_VERSION_MINOR 13

/* Allow usage of libtracecmd private symbols */
#define WITH_TRACE_CMD_PRIVATE_SYMBOLS @tracecmd_private_syms@

/* Enable live source reading (requires tracefs 1.8.0 or later) */
#define WITH_LIVE_SOURCE @with_live_source@

/* optional symbols */
#define HAS_BT2_CLOCK_UID @has_bt2_clock_uid@
#define HAS_BT2_CLOCK_NAMESPACE @has_bt2_clock_namespace@
#define HAS_BT2_CLOCK_UNKNOWN @has_bt2_clock_unknown@
#define HAS_BT2_TRACE_UID @has_bt2_trace_uid@
#define HAS_BT2_TRACE_NAMESPACE @has_bt2_trace_namespace@
#define HAS_BT2_STREAM_CLASS_NAMESPACE @has_bt2_stream_class_namespace@
#define HAS_BT2_STREAM_CLASS_UID @has_bt2_stream_class_uid@
#define HAS_BT2_NEW_DYNAMIC_FIELD_API @has_bt2_new_dynamic_field_api@

#define HAS_TRACECMD_REVERSE_ITERATION @has_tracecmd_reverse_iteration@

// clang-format on

#endif
